NODE_ENV=development
PORT=5000

# MongoDB Connection URI (optional in development; falls back to embedded in-memory database if empty or unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Google Gemini API Configuration (optional in development; falls back to built-in scenario engine if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend Client URL for CORS allowlist
CLIENT_URL=http://localhost:5173

# Mystery Generation Limits & Timeouts
GENERATION_MAX_RETRIES=2
GENERATION_TIMEOUT_MS=90000
MAX_SCENARIO_LENGTH=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
